# Supabase (service-role for writes that bypass RLS — keep secret)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Local filesystem for downloads + keyframes
INGESTION_TMP_DIR=/tmp/shaq-os/ingestion

# Where to call after download completes
ANALYSIS_SERVICE_URL=http://localhost:3002

# Service port
PORT=3001
