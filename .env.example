# SHAQ OS — root .env.example
#
# Most workspaces have their own .env.example with workspace-specific
# vars. This file is an aggregate quick-reference. Copy the relevant
# block into the workspace's .env.local file (e.g. apps/dashboard/.env.local).
#
# See also:
#   apps/dashboard/.env.local.example
# -----------------------------------------------------------------------------

# === Supabase (used by apps/dashboard + future services that hit the DB) ===
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# === AI providers (used by apps/dashboard council, future agents) ===
# Pick one provider, set AI_PROVIDER to match. OpenRouter support TBD.
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
AI_PROVIDER=anthropic

# === App ===
NEXT_PUBLIC_APP_URL=http://localhost:3000

# === Services (optional overrides; defaults shown) ===
# INGESTION_SERVICE_PORT=3001
# ANALYSIS_SERVICE_PORT=3002
# EMBEDDINGS_SERVICE_PORT=3003
# SCHEDULER_SERVICE_PORT=3004
