# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI Provider — use Anthropic (recommended) or OpenAI
# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (alternative)
# OPENAI_API_KEY=sk-...

# Which provider to use: "anthropic" | "openai"
AI_PROVIDER=anthropic

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Blotato — scheduling/distribution. Get the key from app.blotato.com.
# Account IDs come from listing accounts: GET /v2/accounts (or the MCP).
BLOTATO_API_KEY=blotato_...
BLOTATO_INSTAGRAM_ACCOUNT_ID=        # required for IG push (e.g. 48274 @getarchivedsg)
BLOTATO_LINKEDIN_ACCOUNT_ID=         # optional — set to enable LinkedIn cross-post
BLOTATO_LINKEDIN_PAGE_ID=            # optional — set to post to a company page instead of personal

# Notion
NOTION_API_KEY=secret_...
NOTION_DATABASE_ID=                  # content DB id
